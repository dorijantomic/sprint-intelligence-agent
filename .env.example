GITHUB_PROJECT_OWNER=
GITHUB_PROJECT_NUMBER=
GITHUB_ITERATION_ID=
SPRINT_LEDGER_PATH=.data/sprint-intelligence.sqlite

# Optional Jira Cloud OAuth. Create one OAuth 2.0 (3LO) integration in the
# Atlassian developer console and register the callback URL below.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:8787/api/auth/atlassian/callback
ATLASSIAN_APP_URL=http://localhost:5173

# Optional agent runtime. The deterministic evidence path needs no AI provider.
# Values: deterministic | opencode-go | openai | gemini | openai-compatible | custom
AGENT_PROVIDER=
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_RUNTIME_MODULE=

# Backward-compatible OpenAI settings (prefer the generic AGENT_* names above).
OPENAI_API_KEY=
OPENAI_MODEL=
